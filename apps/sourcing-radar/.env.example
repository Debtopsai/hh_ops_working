# Preview mode. Runs every screen on sample data with no Supabase project, for
# looking at the interface before any credentials exist. It is refused when
# SUPABASE_SERVICE_ROLE_KEY is set, so it cannot be left on in front of live data.
PREVIEW_MODE=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server side only. Bypasses row level security, so it never reaches the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Where the dashboard is served from. Used for the digest link in alerts.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp Business Platform Cloud API.
# A dedicated phone number is required, one not already registered to a personal
# WhatsApp account. Leave these unset until that number exists: the transport
# reports "not configured" rather than failing silently.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0

# Email, the audit trail and the WhatsApp fallback.
POSTMARK_SERVER_TOKEN=
ALERT_FROM_EMAIL=

# Inngest, for the scheduled adapter runs.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optional, used by npm run seed:brands.
WASHPRO_STORE_URL=https://washpro.co.nz
